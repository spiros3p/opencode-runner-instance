# opencode-runner - headless opencode server + flat repo fetch helper.
# cp to .env, fill the secrets, then: docker compose up -d --build

# Where to publish the two ports. Tailscale handles reachability; keep this
# 0.0.0.0 only on a private/tailnet host.
BIND_IP=0.0.0.0

# Native opencode HTTP server (sessions, prompts, events, credentials).
OPENCODE_PORT=4096

# Optional browser VS Code. false = headless only, true = also run code-server.
# Requires the compose.ui.yml override to publish the host port.
ENABLE_CODE_SERVER=false
# Host port for VS Code. 8221 by default so it does not clash with the
# all-in-one stack on the same host, and so it matches the Tailscale serve
# target below.
CODE_SERVER_PORT=8221
# Where the VS Code port is published. Loopback by default: code-server is
# full control of the runner. 0.0.0.0 exposes it to the whole LAN.
UI_BIND_IP=127.0.0.1
# Empty = random per boot, printed once in `docker logs`.
CODE_SERVER_PASSWORD=

# Tailscale Serve HTTPS for VS Code (compose.ui.yml only). The helper runs
# `docker exec <TAILSCALE_CONTAINER> tailscale serve --bg --https=<port>
# <target>` once per up. SERVE_TARGET is resolved INSIDE the tailscale
# container: a bare port means its own localhost (host network), a URL like
# http://opencode-runner:8443 means docker network name.
TAILSCALE_CONTAINER=tailscale
TAILSCALE_HTTPS_PORT=8221
SERVE_TARGET=8221
# SERVE_TARGET must equal CODE_SERVER_PORT (bare port = host loopback) unless
# you use the URL form, which needs the tailscale container on this network.
TAILSCALE_NETWORK=opencode_runner_default

# Basic auth for opencode: username defaults to "opencode".
# Must be non-empty. Use a long random value.
OPENCODE_PASSWORD=
# Optional override of the Basic auth username.
# OPENCODE_SERVER_USERNAME=opencode

# GitHub PAT used by fetch-repo to clone private github.com repos over HTTPS.
# Needs repo scope for the repos this runner may work on. Public repos work
# without it. The token is visible to the agent shell via env.
# NOTE: it must NOT be called GITHUB_TOKEN. The models.dev catalog maps that
# name to the github-copilot provider, and the Copilot API rejects PATs, so a
# GITHUB_TOKEN value would break every copilot turn. Boot fails fast if the
# legacy name is still set. Copilot needs an OAuth token in auth.json instead.
FETCH_GITHUB_TOKEN=

# Runner-wide default model (provider/id). Leave empty: the delegating agent
# passes the model per session (e.g. opencode-go/deepseek-v4.1-flash from the
# orchestrator seat config), which is the supported setup. Boot warns when
# this is empty, and a set value always wins over the model stored in
# opencode.json. Any default provider needs its working key below, and the
# model id must exist in GET /api/model.
OPENCODE_MODEL=

# Wait budget: how long POST /api/session/{id}/wait blocks before answering
# 204 anyway (callers then poll messages). Single value, seconds.
# 540 keeps every wait+poll cycle inside the caller single deadline of 600s.
WAIT_TIMEOUT_SECONDS=540

GIT_IDENTITY_NAME=SipAgent
GIT_IDENTITY_EMAIL=sipagent@localhost

# Provider keys. opencode reads these from the server process env.
# OPENCODE_API_KEY is used by both the OpenCode Console (provider id
# "opencode") and the OpenCode Go subscription (provider id "opencode-go").
OPENCODE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
