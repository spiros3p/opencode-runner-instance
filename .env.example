# opencode-runner - headless opencode server + flat repo fetch helper.
# cp to .env, fill the secrets, then: docker compose up -d --build

# Where to publish the two ports. Tailscale handles reachability; keep this
# 0.0.0.0 only on a private/tailnet host.
BIND_IP=0.0.0.0

# Native opencode HTTP server (sessions, prompts, events, credentials).
OPENCODE_PORT=4096

# Optional browser VS Code. false = headless only, true = also run code-server.
# Requires the compose.ui.yml override to publish the host port.
ENABLE_CODE_SERVER=false
CODE_SERVER_PORT=8222
# Empty = random per boot, printed once in `docker logs`.
CODE_SERVER_PASSWORD=

# Basic auth for opencode: username defaults to "opencode".
# Must be non-empty. Use a long random value.
OPENCODE_PASSWORD=
# Optional override of the Basic auth username.
# OPENCODE_SERVER_USERNAME=opencode

# GitHub PAT used by fetch-repo to clone private github.com repos over HTTPS.
# Needs repo scope for the repos this runner may work on. Public repos work
# without it. The token is visible to the agent shell via env.
GITHUB_TOKEN=

# Default model for every new session, e.g. opencode-go/deepseek-v4-pro.
# Written into the seeded opencode.json only when no model is set there.
OPENCODE_MODEL=

GIT_IDENTITY_NAME=SipAgent
GIT_IDENTITY_EMAIL=sipagent@localhost

# Provider keys. opencode reads these from the server process env.
# OPENCODE_API_KEY is used by both the OpenCode Console (provider id
# "opencode") and the OpenCode Go subscription (provider id "opencode-go").
OPENCODE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
