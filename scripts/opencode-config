#!/usr/bin/env python3
"""Seed or repair the V2 opencode config for a headless runner.

  * writes a fresh config when none exists (model + V2 `permissions` array)
  * translates V1 `permission` blocks into V2 rules instead of dropping denies
  * adds headless defaults only for rules the operator did not set, then keeps
    every operator rule in its written order (V2 uses the LAST matching rule)
  * keeps the *.env deny as a final floor unless the operator explicitly allows
    that exact path
  * keeps every other key, including provider/MCP/theme settings
  * never fails the boot: a broken config is backed up and replaced

Prints one status line on stdout. Warnings go to stderr.
"""
import fnmatch
import json
import os
import sys

SCHEMA = "https://opencode.ai/config.json"
PAT_NAMES = ("GITHUB_TOKEN", "FETCH_GITHUB_TOKEN", "GH_TOKEN")
PAT_PREFIXES = ("ghp_", "github_pat_")

# V2 defaults. The last matching rule wins, so the broad allow comes first.
DEFAULTS = [
    {"action": "*", "resource": "*", "effect": "allow"},
    {"action": "read", "resource": "*.env", "effect": "deny"},
    {"action": "read", "resource": "*.env.*", "effect": "deny"},
    {"action": "read", "resource": "*.env.example", "effect": "allow"},
    {"action": "external_directory", "resource": "*", "effect": "allow"},
]
V1_ACTIONS = {"bash": "shell", "task": "subagent"}


def strip_jsonc(text):
    """Drop // and /* */ comments and trailing commas, respecting strings."""
    out, i, n = [], 0, len(text)
    in_str, esc = False, False
    while i < n:
        c = text[i]
        if in_str:
            out.append(c)
            if esc:
                esc = False
            elif c == "\\":
                esc = True
            elif c == '"':
                in_str = False
            i += 1
            continue
        if c == '"':
            in_str = True
            out.append(c)
            i += 1
            continue
        if c == "/" and i + 1 < n and text[i + 1] == "/":
            while i < n and text[i] != "\n":
                i += 1
            continue
        if c == "/" and i + 1 < n and text[i + 1] == "*":
            i += 2
            while i + 1 < n and not (text[i] == "*" and text[i + 1] == "/"):
                i += 1
            i += 2
            continue
        if c in "}]":
            j = len(out) - 1
            while j >= 0 and out[j].isspace():
                j -= 1
            if j >= 0 and out[j] == ",":
                del out[j]
        out.append(c)
        i += 1
    return "".join(out)


def translate_v1(v1, warnings):
    """Convert one V1 permission block into V2 rules."""
    rules = []
    if isinstance(v1, str):
        v1 = {"*": v1}
    if not isinstance(v1, dict):
        warnings.append("V1 permission block is not an object; skipped")
        return rules
    for action, value in v1.items():
        if action in ("doom_loop", "lsp"):
            warnings.append("V1 action %s has no V2 equivalent" % action)
            continue
        mapped = V1_ACTIONS.get(action, action)
        if isinstance(value, str):
            value = {"*": value}
        if not isinstance(value, dict):
            warnings.append("V1 %s rule is not an object; skipped" % action)
            continue
        for resource, effect in value.items():
            rules.append({"action": mapped, "resource": resource, "effect": effect})
    return rules


def pop_v1_permissions(cfg, warnings):
    """Take V1 permission blocks only where documented; return their rules."""
    rules = []
    if "permission" in cfg:
        rules.extend(translate_v1(cfg.pop("permission"), warnings))
    for key in ("agent", "agents"):
        agents = cfg.get(key)
        if not isinstance(agents, dict):
            continue
        for agent in agents.values():
            if isinstance(agent, dict) and "permission" in agent:
                agent_rules = translate_v1(agent.pop("permission"), warnings)
                existing = agent.get("permissions")
                if isinstance(existing, list):
                    agent["permissions"] = existing + agent_rules
                else:
                    agent["permissions"] = agent_rules
    return rules


def is_pat(value):
    if not isinstance(value, str):
        return False
    return (
        any(name in value for name in PAT_NAMES)
        or value.startswith(PAT_PREFIXES)
    )


def sanitize_pat_providers(cfg):
    """Drop provider credentials sourced from a GitHub PAT. Returns ids fixed."""
    fixed = []
    for key, holder in (("providers", "settings"), ("provider", "options")):
        providers = cfg.get(key)
        if not isinstance(providers, dict):
            continue
        for pid, pconf in providers.items():
            if not isinstance(pconf, dict):
                continue
            changed = False
            for place in (pconf, pconf.get(holder)):
                if not isinstance(place, dict):
                    continue
                if "apiKey" in place and is_pat(place["apiKey"]):
                    del place["apiKey"]
                    changed = True
                env = place.get("env")
                if isinstance(env, list):
                    kept = [e for e in env if not is_pat(e)]
                    if len(kept) != len(env):
                        place["env"] = kept
                        changed = True
            if changed:
                fixed.append(pid)
    return fixed


def effective(rules, action, path):
    """Last matching rule wins, like V2 opencode."""
    result = "ask"
    for rule in rules:
        if rule.get("action") not in ("*", action):
            continue
        if fnmatch.fnmatch(path, str(rule.get("resource", ""))):
            result = rule.get("effect", "ask")
    return result


def merge_permissions(cfg, v1_rules):
    """Defaults first, then translated V1 rules, then operator rules in order."""
    current = cfg.get("permissions")
    if not isinstance(current, list):
        if current is not None:
            print(
                "WARN: permissions is not a list; replacing with headless defaults",
                file=sys.stderr,
            )
        current = []
    operator, warnings = [], []
    for rule in current:
        if not isinstance(rule, dict):
            warnings.append("dropped non-object permission rule")
            continue
        if rule.get("effect") not in ("allow", "deny", "ask"):
            warnings.append("dropped rule with invalid effect: %r" % rule.get("effect"))
            continue
        operator.append(rule)
    for w in warnings:
        print("WARN: %s" % w, file=sys.stderr)

    all_rules = list(v1_rules) + operator
    merged = []
    for default in DEFAULTS:
        key = (default["action"], default["resource"])
        if not any((r.get("action"), r.get("resource")) == key for r in all_rules):
            merged.append(dict(default))
    merged.extend(all_rules)

    # Safety floor: never let an accidental broad rule expose .env files, but
    # respect an operator's explicit allow for that exact path.
    for path, pattern in ((".env", "*.env"), (".env.local", "*.env.*")):
        explicit_allow = any(
            r.get("action") in ("*", "read")
            and r.get("resource") == pattern
            and r.get("effect") == "allow"
            for r in all_rules
        )
        if not explicit_allow and effective(merged, "read", path) != "deny":
            merged.append({"action": "read", "resource": pattern, "effect": "deny"})
    cfg["permissions"] = merged


def fresh_config(model):
    cfg = {"$schema": SCHEMA}
    if model:
        cfg["model"] = model
    merge_permissions(cfg, [])
    return cfg


def write(path, cfg):
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")
    os.replace(tmp, path)


def backup(path, suffix):
    try:
        os.replace(path, path + suffix)
        return True
    except OSError:
        return False


def main():
    if len(sys.argv) != 2:
        print("usage: opencode-config <config-path>", file=sys.stderr)
        return 0
    path = sys.argv[1]
    model = os.environ.get("OPENCODE_MODEL", "").strip()
    if model and "/" not in model:
        print(
            "WARN: OPENCODE_MODEL=%r has no provider prefix; use provider/id "
            "(e.g. opencode-go/deepseek-v4.1-flash)" % model,
            file=sys.stderr,
        )

    if not os.path.exists(path):
        write(path, fresh_config(model))
        print("created %s" % path)
        return 0

    try:
        with open(path, "rb") as f:
            raw = f.read()
        text = raw.decode("utf-8-sig", errors="replace")
    except OSError as e:
        print("WARN: cannot read %s: %s" % (path, e), file=sys.stderr)
        print("unreadable %s" % path)
        return 0

    try:
        cfg = json.loads(strip_jsonc(text))
    except ValueError as e:
        print("WARN: %s is not valid JSON(C): %s" % (path, e), file=sys.stderr)
        if backup(path, ".invalid"):
            write(path, fresh_config(model))
            print("replaced invalid config (backup: %s.invalid)" % path)
        else:
            print("invalid config left in place")
        return 0

    if not isinstance(cfg, dict):
        print("WARN: %s is not a JSON object" % path, file=sys.stderr)
        if backup(path, ".invalid"):
            write(path, fresh_config(model))
            print("replaced non-object config (backup: %s.invalid)" % path)
        return 0

    warnings = []
    v1_present = "permission" in cfg
    for key in ("agent", "agents"):
        agents = cfg.get(key)
        if isinstance(agents, dict):
            v1_present = v1_present or any(
                isinstance(a, dict) and "permission" in a for a in agents.values()
            )
    v1_rules = pop_v1_permissions(cfg, warnings)
    if v1_rules:
        warnings.append("translated %d V1 permission rule(s)" % len(v1_rules))
    for w in warnings:
        print("WARN: %s" % w, file=sys.stderr)
    changed = v1_present

    fixed = sanitize_pat_providers(cfg)
    if fixed:
        print(
            "note: removed fetch-PAT apiKey/env from provider(s) %s; "
            "Copilot needs an OAuth token via auth.json, not the fetch PAT"
            % ", ".join(fixed),
            file=sys.stderr,
        )
        changed = True

    before = json.dumps(cfg.get("permissions"))
    merge_permissions(cfg, v1_rules)
    if json.dumps(cfg.get("permissions")) != before:
        changed = True

    if model:
        if cfg.get("model") != model:
            if "model" in cfg:
                print(
                    "note: OPENCODE_MODEL=%s overrides %s model=%s"
                    % (model, path, cfg.get("model")),
                    file=sys.stderr,
                )
            cfg["model"] = model
            changed = True

    if changed:
        backup(path, ".bak")
        write(path, cfg)
        print("updated %s%s" % (path, " (V1 permissions translated)" if v1_rules else ""))
    else:
        print("ok %s" % path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
