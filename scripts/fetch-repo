#!/usr/bin/env bash
# Clone a repo once into the flat /workspace layout. Uses FETCH_GITHUB_TOKEN for
# github.com HTTPS clones via askpass, so the PAT never enters argv or
# .git/config. Prints the absolute directory on stdout; logs go to stderr.
set -euo pipefail
WORKSPACE="${WORKSPACE:-/workspace}"
log() { printf '[fetch-repo] %s\n' "$*" >&2; }
die() { log "$*"; exit 2; }

[ "$(id -u)" -ne 0 ] || die "run as agent: docker exec -u agent opencode-runner fetch-repo ..."
[ $# -ge 1 ] || die "usage: fetch-repo <owner/repo|https-url> [ref]"
SPEC="$1"
REF="${2:-}"

case "$SPEC" in
  git@*|ssh://*) die "SSH URLs need a deploy key; this runner is PAT-only" ;;
  http://*) die "http is not allowed; use https" ;;
  https://*|*/*) ;;
  *) die "expected owner/repo or https URL" ;;
esac

case "$SPEC" in
  https://*) URL="$SPEC" ;;
  *) URL="https://github.com/${SPEC%.git}.git" ;;
esac
URL="${URL%/}"
case "$URL" in
  *.git) ;;
  *) URL="$URL.git" ;;
esac

canonical() {
  # Normalize any git URL form to host/path so an existing checkout is
  # recognised whatever it was cloned with: https, http, ssh://, scp-like
  # SSH (git@host:path), git://, upper-case hosts, tokens or ports in the
  # URL, trailing slashes and .git suffixes. Scheme is dropped on purpose:
  # an old http:// origin is still the same repo as the https:// request.
  local u="$1" tmp rest host path
  case "$u" in
    *://*) ;;
    *:*)
      case "${u%%:*}" in
        *[/\]*) ;; # local path with a colon, not scp-like; leave alone
        *) tmp="${u#*@}"; u="https://${tmp%%:*}/${tmp#*:}" ;;
      esac
      ;;
  esac
  u="${u%/}"; u="${u%.git}"
  rest="${u#*://}"
  host="${rest%%/*}"; path="${rest#*/}"
  host="${host##*@}" # strip userinfo (user or user:pass token)
  case "$host" in
    [[]*[]]*) host="${host%%]*}" ;; # bracketed IPv6: drop :port, keep [addr]
    *) host="${host%%:*}" ;; # strip port
  esac
  host="$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')"
  host="${host#www.}"
  printf '%s/%s\n' "$host" "$path"
}
CANON="$(canonical "$URL")"
REST="${URL#*://}"
HOST="${REST%%/*}"
case "$HOST" in
  *@*) die "URL must not contain credentials" ;;
  github.com|www.github.com) USE_PAT=1 ;;
  *) USE_PAT=0 ;;
esac

BASE="${URL##*/}"
BASE="${BASE%.git}"
NAME="$(printf '%s' "$BASE" | sed 's/[^A-Za-z0-9._-]/-/g; s/^[-._]*//; s/[-._]*$//')"
[ -n "$NAME" ] || NAME=repo
SUM="$(printf '%s' "$CANON" | cksum | cut -d' ' -f1)"
# Pre-upgrade releases checksummed "https://host/path" (scheme included).
# Keep looking at the old number so a clash folder from that era is reused
# instead of cloned a second time.
SUM_OLD="$(printf '%s' "https://$CANON" | cksum | cut -d' ' -f1)"

mkdir -p "$WORKSPACE"
LOCK="/tmp/fetch-repo-$NAME.lock"
if command -v flock >/dev/null 2>&1; then
  exec 9>"$LOCK"
  flock 9
fi

# Flat layout: reuse first, clone second. Pass 1 reuses any existing checkout
# (canonical dir or either suffix generation) whose origin resolves to the
# same repo, whatever URL form it was cloned with. Pass 2 clones into the
# first free slot. Only a genuinely different repo under the same name takes
# the suffix dir; anything else unresolvable dies loudly instead of silently
# cloning a duplicate.
DIR=""
for CAND in "$WORKSPACE/$NAME" "$WORKSPACE/$NAME-$SUM" "$WORKSPACE/$NAME-$SUM_OLD"; do
  [ -e "$CAND" ] || continue
  # rev-parse (not a .git dir test) so linked worktrees, whose .git is a
  # file, are recognised as repos and reused too.
  git -C "$CAND" rev-parse --git-dir >/dev/null 2>&1 || continue
  ORIGIN="$(git -C "$CAND" remote get-url origin 2>/dev/null || true)"
  if [ "$CAND" = "$WORKSPACE/$NAME" ]; then
    if [ -z "$ORIGIN" ] || [ "$(canonical "$ORIGIN")" = "$CANON" ]; then
      DIR="$CAND"
      break
    fi
  elif [ -n "$ORIGIN" ] && [ "$(canonical "$ORIGIN")" = "$CANON" ]; then
    DIR="$CAND"
    break
  fi
done
if [ -z "$DIR" ]; then
  for CAND in "$WORKSPACE/$NAME" "$WORKSPACE/$NAME-$SUM"; do
    if [ ! -e "$CAND" ]; then
      DIR="$CAND"
      break
    fi
    if ! git -C "$CAND" rev-parse --git-dir >/dev/null 2>&1; then
      [ "$CAND" = "$WORKSPACE/$NAME" ] && continue
      die "target exists but is not a git repo: $CAND"
    fi
  done
fi
[ -n "$DIR" ] || die "unresolved name collision for $NAME"

if git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1; then
  if [ -n "$REF" ]; then
    ACTUAL="$(git -C "$DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    [ "$ACTUAL" = "$REF" ] || log "WARN: $DIR is on '$ACTUAL', not requested '$REF'"
  fi
  printf '%s\n' "$DIR"
  exit 0
fi

if [ "$USE_PAT" = 1 ]; then
  export GIT_TERMINAL_PROMPT=0
  if [ -n "${FETCH_GITHUB_TOKEN:-}" ]; then
    export GIT_ASKPASS=/usr/local/bin/git-askpass
  else
    log "FETCH_GITHUB_TOKEN unset; public github.com repos only"
  fi
else
  export GIT_TERMINAL_PROMPT=0
fi

CLONE=(git clone)
if command -v timeout >/dev/null 2>&1; then
  CLONE=(timeout 900 git clone)
fi
[ -n "$REF" ] && CLONE+=(--branch "$REF" --single-branch)
TMP="$(mktemp -d "$WORKSPACE/.fetch-$NAME.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT
CLONE+=(-- "$URL" "$TMP")
log "clone $URL -> $DIR"
"${CLONE[@]}" >&2
mv "$TMP" "$DIR"
trap - EXIT
printf '%s\n' "$DIR"
